rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function approvedDriver(uid) {
      return signedIn()
        && profile(uid).role == 'driver'
        && profile(uid).driverStatus == 'approved';
    }

    match /users/{uid} {
      function submittingDriverApplication() {
        let application =
          getAfter(/databases/$(database)/documents/driverApplications/$(uid)).data;
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['driverStatus'])
          && request.resource.data.driverStatus == 'pending'
          && (!('driverStatus' in resource.data)
            || resource.data.driverStatus == 'none')
          && application.uid == uid
          && application.status == 'pending'
          && application.name == resource.data.name
          && application.phone == resource.data.phone
          && application.submittedAt == request.time;
      }

      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'phone', 'role', 'driverStatus', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'role', 'driverStatus', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.role == 'customer'
        && request.resource.data.driverStatus == 'none'
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          (
            request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            && request.resource.data.driverStatus == resource.data.driverStatus
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'phone'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.phone is string
            && request.resource.data.phone.size() <= 30
          )
          || submittingDriverApplication()
        );

      allow delete: if false;
    }

    match /driverApplications/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && (profile(uid).role == 'customer' || !('role' in profile(uid)))
        && (
          !('driverStatus' in profile(uid))
          || profile(uid).driverStatus == 'none'
        )
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.driverStatus
          == 'pending'
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'phone', 'status', 'submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'status', 'submittedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name == profile(uid).name
        && request.resource.data.phone == profile(uid).phone
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time;

      allow update, delete: if false;
    }

    match /rides/{rideId} {
      function customerOwnsRide() {
        return signedIn() && resource.data.customerUid == request.auth.uid;
      }

      function driverOwnsRide() {
        return approvedDriver(request.auth.uid)
          && resource.data.driverUid == request.auth.uid;
      }

      function validNewRide() {
        let data = request.resource.data;
        let publicRequest =
          getAfter(/databases/$(database)/documents/rideRequests/$(rideId)).data;
        let customer = profile(request.auth.uid);

        return signedIn()
          && data.keys().hasAll([
            'customerUid', 'customerName', 'phone', 'pickup', 'destination',
            'rideType', 'instructions', 'status', 'createdAt', 'driverUid',
            'driverName', 'driverPhone'
          ])
          && data.keys().hasOnly([
            'customerUid', 'customerName', 'phone', 'pickup', 'destination',
            'rideType', 'instructions', 'status', 'createdAt', 'driverUid',
            'driverName', 'driverPhone'
          ])
          && data.customerUid == request.auth.uid
          && (
            customer.role == 'customer'
            || !('role' in customer)
          )
          && data.customerName == customer.name
          && data.phone is string
          && data.phone.size() > 0
          && data.phone.size() <= 30
          && data.pickup is string
          && data.pickup.size() > 0
          && data.pickup.size() <= 160
          && data.destination is string
          && data.destination.size() > 0
          && data.destination.size() <= 160
          && data.rideType == 'bike'
          && data.instructions is string
          && data.instructions.size() <= 300
          && data.status == 'requested'
          && data.createdAt == request.time
          && data.driverUid == null
          && data.driverName == null
          && data.driverPhone == null
          && publicRequest.customerUid == data.customerUid
          && publicRequest.pickup == data.pickup
          && publicRequest.destination == data.destination
          && publicRequest.rideType == data.rideType
          && publicRequest.status == 'requested'
          && publicRequest.createdAt == data.createdAt
          && publicRequest.driverUid == null;
      }

      function customerCancel() {
        let publicRequest =
          getAfter(/databases/$(database)/documents/rideRequests/$(rideId)).data;
        return customerOwnsRide()
          && resource.data.status == 'requested'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt'])
          && publicRequest.status == 'cancelled'
          && publicRequest.cancelledAt == request.time;
      }

      function driverProgress() {
        let publicRequest =
          getAfter(/databases/$(database)/documents/rideRequests/$(rideId)).data;
        let changed =
          request.resource.data.diff(resource.data).affectedKeys();

        return driverOwnsRide()
          && publicRequest.driverUid == request.auth.uid
          && (
            (
              resource.data.status == 'accepted'
              && request.resource.data.status == 'arrived'
              && request.resource.data.arrivedAt == request.time
              && changed.hasOnly(['status', 'arrivedAt'])
              && publicRequest.status == 'arrived'
              && publicRequest.arrivedAt == request.time
            )
            ||
            (
              resource.data.status == 'arrived'
              && request.resource.data.status == 'in_progress'
              && resource.data.fareStatus == 'accepted'
              && request.resource.data.startedAt == request.time
              && changed.hasOnly(['status', 'startedAt'])
              && publicRequest.status == 'in_progress'
              && publicRequest.startedAt == request.time
            )
            ||
            (
              resource.data.status == 'in_progress'
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt == request.time
              && changed.hasOnly(['status', 'completedAt'])
              && publicRequest.status == 'completed'
              && publicRequest.completedAt == request.time
            )
          );
      }

      function driverRelease() {
        let publicRequest =
          getAfter(/databases/$(database)/documents/rideRequests/$(rideId)).data;
        let changed =
          request.resource.data.diff(resource.data).affectedKeys();

        return driverOwnsRide()
          && resource.data.status in ['accepted', 'arrived']
          && request.resource.data.status == 'requested'
          && request.resource.data.driverUid == null
          && request.resource.data.driverName == null
          && request.resource.data.driverPhone == null
          && request.resource.data.acceptedAt == null
          && request.resource.data.arrivedAt == null
          && request.resource.data.releasedAt == request.time
          && request.resource.data.fareQuote == null
          && request.resource.data.fareStatus == null
          && request.resource.data.fareOfferedAt == null
          && request.resource.data.fareRespondedAt == null
          && changed.hasOnly([
            'status', 'driverUid', 'driverName', 'driverPhone',
            'acceptedAt', 'arrivedAt', 'releasedAt',
            'fareQuote', 'fareStatus', 'fareOfferedAt', 'fareRespondedAt'
          ])
          && publicRequest.status == 'requested'
          && publicRequest.driverUid == null
          && publicRequest.releasedAt == request.time;
      }

      function driverOffersFare() {
        let hasNoAcceptedFare =
          !('fareStatus' in resource.data)
          || resource.data.fareStatus != 'accepted';
        return driverOwnsRide()
          && resource.data.status in ['accepted', 'arrived']
          && hasNoAcceptedFare
          && request.resource.data.fareQuote is int
          && request.resource.data.fareQuote >= 1
          && request.resource.data.fareQuote <= 1000000
          && request.resource.data.fareStatus == 'offered'
          && request.resource.data.fareOfferedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fareQuote', 'fareStatus', 'fareOfferedAt']);
      }

      function customerRespondsToFare() {
        return customerOwnsRide()
          && resource.data.status in ['accepted', 'arrived']
          && resource.data.fareStatus == 'offered'
          && resource.data.fareQuote is int
          && request.resource.data.fareStatus in ['accepted', 'declined']
          && request.resource.data.fareRespondedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fareStatus', 'fareRespondedAt']);
      }

      allow get: if customerOwnsRide() || driverOwnsRide();
      allow list: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || (
            approvedDriver(request.auth.uid)
            && resource.data.driverUid == request.auth.uid
          )
        );
      allow create: if validNewRide();
      allow update: if customerCancel()
        || driverProgress()
        || driverRelease()
        || driverOffersFare()
        || customerRespondsToFare();
      allow delete: if false;

      match /messages/{messageId} {
        function ride() {
          return get(/databases/$(database)/documents/rides/$(rideId)).data;
        }

        function participant() {
          return signedIn()
            && (
              ride().customerUid == request.auth.uid
              || (
                ride().driverUid == request.auth.uid
                && approvedDriver(request.auth.uid)
              )
            )
            && ride().status in ['accepted', 'arrived', 'in_progress'];
        }

        allow get, list: if participant();
        allow create: if participant()
          && request.resource.data.keys().hasAll([
            'senderUid', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName == profile(request.auth.uid).name
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /rideRequests/{rideId} {
      function customerOwnsRequest() {
        return signedIn() && resource.data.customerUid == request.auth.uid;
      }

      function driverOwnsRequest() {
        return approvedDriver(request.auth.uid)
          && resource.data.driverUid == request.auth.uid;
      }

      function validNewRequest() {
        let data = request.resource.data;
        let ride =
          getAfter(/databases/$(database)/documents/rides/$(rideId)).data;
        return signedIn()
          && data.keys().hasAll([
            'customerUid', 'pickup', 'destination', 'rideType',
            'status', 'createdAt', 'driverUid'
          ])
          && data.keys().hasOnly([
            'customerUid', 'pickup', 'destination', 'rideType',
            'status', 'createdAt', 'driverUid'
          ])
          && data.customerUid == request.auth.uid
          && data.pickup is string
          && data.pickup.size() > 0
          && data.pickup.size() <= 160
          && data.destination is string
          && data.destination.size() > 0
          && data.destination.size() <= 160
          && data.rideType == 'bike'
          && data.status == 'requested'
          && data.createdAt == request.time
          && data.driverUid == null
          && ride.customerUid == data.customerUid
          && ride.pickup == data.pickup
          && ride.destination == data.destination
          && ride.rideType == data.rideType
          && ride.status == 'requested';
      }

      function customerCancel() {
        let ride =
          getAfter(/databases/$(database)/documents/rides/$(rideId)).data;
        return customerOwnsRequest()
          && resource.data.status == 'requested'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt'])
          && ride.status == 'cancelled'
          && ride.cancelledAt == request.time;
      }

      function driverProgress() {
        let ride =
          getAfter(/databases/$(database)/documents/rides/$(rideId)).data;
        let changed =
          request.resource.data.diff(resource.data).affectedKeys();
        return driverOwnsRequest()
          && (
            (
              resource.data.status == 'accepted'
              && request.resource.data.status == 'arrived'
              && request.resource.data.arrivedAt == request.time
              && changed.hasOnly(['status', 'arrivedAt'])
              && ride.status == 'arrived'
              && ride.arrivedAt == request.time
            )
            ||
            (
              resource.data.status == 'arrived'
              && request.resource.data.status == 'in_progress'
              && request.resource.data.startedAt == request.time
              && changed.hasOnly(['status', 'startedAt'])
              && ride.status == 'in_progress'
              && ride.startedAt == request.time
            )
            ||
            (
              resource.data.status == 'in_progress'
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt == request.time
              && changed.hasOnly(['status', 'completedAt'])
              && ride.status == 'completed'
              && ride.completedAt == request.time
            )
          )
          && ride.driverUid == request.auth.uid;
      }

      function driverRelease() {
        let ride =
          getAfter(/databases/$(database)/documents/rides/$(rideId)).data;
        let changed =
          request.resource.data.diff(resource.data).affectedKeys();
        return driverOwnsRequest()
          && resource.data.status in ['accepted', 'arrived']
          && request.resource.data.status == 'requested'
          && request.resource.data.driverUid == null
          && request.resource.data.acceptedAt == null
          && request.resource.data.arrivedAt == null
          && request.resource.data.releasedAt == request.time
          && changed.hasOnly([
            'status', 'driverUid', 'acceptedAt', 'arrivedAt', 'releasedAt'
          ])
          && ride.status == 'requested'
          && ride.driverUid == null
          && ride.releasedAt == request.time;
      }

      allow get: if customerOwnsRequest() || driverOwnsRequest();
      allow list: if approvedDriver(request.auth.uid)
        && resource.data.status == 'requested';
      allow create: if validNewRequest();
      allow update: if customerCancel() || driverProgress() || driverRelease();
      allow delete: if false;
    }
  }
}
